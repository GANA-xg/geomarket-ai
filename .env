# GeoMarket AI Environment Variables

# DATABASE
# PostgreSQL Database connection string
DATABASE_URL=postgresql://admin:password@db:5432/geomarket

# THIRD PARTY APIs
# API key for fetching geopolitical news (e.g., NewsAPI or similar)
NEWS_API_KEY=your_news_api_key_here
# Session token for TradingView data pulling (if applicable)
TRADINGVIEW_SESSION=your_tradingview_session_here
# Screener India API for fundamental stock valuation (Warren Buffett filter)
SCREENER_IN_API=your_screener_api_key_here

# BACKEND CONFIGURATION
# JWT Secret Key for authenticating user portfolios
SECRET_KEY=your_super_secret_key_here
# Hashing Algorithm
ALGORITHM=HS256
# Token Expiration in Minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# FRONTEND CONFIGURATION
# Backend API URL for the Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Backend WebSocket URL for real-time streaming
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
