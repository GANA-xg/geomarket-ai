# ─── Database ─────────────────────────────────────────────────────────────────
# Local SQLite (default — no setup needed):
DATABASE_URL=sqlite:///./geomarket.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/geomarket

# ─── Third-party APIs ─────────────────────────────────────────────────────────
NEWS_API_KEY=your_newsapi_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
UPSTOX_ACCESS_TOKEN=your_upstox_token_here
FMP_API_KEY=your_fmp_key_here
OPENAI_API_KEY=your_openai_key_here

# ─── Auth ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── AI/ML toggles ────────────────────────────────────────────────────────────
# Set ENABLE_FINBERT=1 only if you have enough RAM (needs torch ~2 GB)
ENABLE_FINBERT=0
ENABLE_SPACY=1

# ─── Performance ──────────────────────────────────────────────────────────────
REQUEST_TIMEOUT_SECONDS=3
CACHE_TTL_SECONDS=60

# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
