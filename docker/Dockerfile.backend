FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

# Download FinBERT and spaCy model during build to cache them
RUN pip install https://github.com/explosion/spacy-models/releases/download/en_core_web_lg-3.7.1/en_core_web_lg-3.7.1-py3-none-any.whl || \
    pip install https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.7.1/en_core_web_sm-3.7.1-py3-none-any.whl
# Pre-download transformers model
RUN python -c "from transformers import pipeline; pipeline('text-classification', model='ProsusAI/finbert')" || true

COPY . .

RUN chmod +x /app/start.sh

CMD ["bash", "/app/start.sh"]
